# ---------------------------------------------------------------------------
# CityWalk with Ease — environment template
#
# Copy this file to `.env.local` and fill in what you need:
#   Windows:  copy .env.example .env.local
#   macOS/Linux: cp .env.example .env.local
#
# `.env.local` is git-ignored. The app still runs without any key: the planner
# falls back to the deterministic local pipeline, the map shows a schematic
# SVG fallback and the detail panel shows text only.
# ---------------------------------------------------------------------------

# ── DeepSeek route-planning service (server-side only) ────────────────────
# Without DEEPSEEK_API_KEY, /api/agent/health reports configured=false and the
# front-end uses the local deterministic planner instead.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── AMap (Gaode) — optional basemap and place details ─────────────────────
# Web service key: server-side place photos, address, opening hours, rating.
# Create a "Web service" key in the AMap console. Never exposed to the browser.
AMAP_WEB_KEY=

# Web-side (JS API) key: browser basemap and markers.
# Create a "Web (JS API)" key and whitelist http://127.0.0.1:5178 as Referer.
VITE_AMAP_KEY=

# JS API security code, forwarded by the local `/_AMapService` proxy.
# Needed for real AMap.Walking routes; without it the planner draws straight
# dashed lines between stops. Do NOT add the VITE_ prefix.
AMAP_SECURITY_CODE=

# Enable the AMap 3D view (requires the JS API key + security code).
VITE_AMAP_3D=false
