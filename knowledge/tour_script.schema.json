{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citywalk.local/schemas/tour_script.schema.json",
  "title": "CityWalk Tour Script",
  "description": "云径·CityWalk 前端唯一消费契约。1.0.0 为既有 pipeline 产物，原样冻结；1.1.0 为 v4 成都版契约（meta.city / budget / dropped / 五步 agent_trace，route[].leg）。按 schema_version 分支校验，两版并存。",
  "oneOf": [
    {
      "$ref": "#/$defs/v1_0_0"
    },
    {
      "$ref": "#/$defs/v1_1_0"
    }
  ],
  "$defs": {
    "v1_0_0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request",
        "city",
        "route",
        "narration",
        "scene_commands",
        "meta"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_text",
            "city_id",
            "duration_budget_min",
            "interests",
            "constraints",
            "pace"
          ],
          "properties": {
            "raw_text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "city_id": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            },
            "duration_budget_min": {
              "type": "integer",
              "minimum": 60,
              "maximum": 1440
            },
            "interests": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 12
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 12
            },
            "pace": {
              "type": "string",
              "enum": [
                "relaxed",
                "balanced",
                "packed"
              ]
            }
          }
        },
        "city": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "city_id",
            "name",
            "tagline"
          ],
          "properties": {
            "city_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "tagline": {
              "type": "string"
            }
          }
        },
        "route": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "poi_id",
              "name",
              "scene_asset_id",
              "duration_min",
              "time_slot",
              "arrival_time",
              "energy",
              "camera_preset",
              "hotspots"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "poi_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "scene_asset_id": {
                "type": "string"
              },
              "duration_min": {
                "type": "integer",
                "minimum": 15,
                "maximum": 180
              },
              "time_slot": {
                "type": "string",
                "enum": [
                  "morning",
                  "afternoon",
                  "evening"
                ]
              },
              "arrival_time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "energy": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "camera_preset": {
                "type": "string"
              },
              "hotspots": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 6
              }
            }
          }
        },
        "narration": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "arrival",
              "focus",
              "transition",
              "disclaimer"
            ],
            "properties": {
              "arrival": {
                "type": "string",
                "minLength": 10
              },
              "focus": {
                "type": "string",
                "minLength": 10
              },
              "transition": {
                "type": "string",
                "minLength": 6
              },
              "disclaimer": {
                "type": "string"
              }
            }
          }
        },
        "scene_commands": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "poi_id",
              "model_key",
              "camera_preset",
              "hotspots",
              "env",
              "transition"
            ],
            "properties": {
              "poi_id": {
                "type": "string"
              },
              "model_key": {
                "type": "string"
              },
              "camera_preset": {
                "type": "string"
              },
              "hotspots": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "time_of_day",
                  "weather",
                  "fog_density"
                ],
                "properties": {
                  "time_of_day": {
                    "type": "string",
                    "enum": [
                      "morning",
                      "afternoon",
                      "evening"
                    ]
                  },
                  "weather": {
                    "type": "string",
                    "enum": [
                      "clear",
                      "cloudy",
                      "rain"
                    ]
                  },
                  "fog_density": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.1
                  }
                }
              },
              "transition": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "duration_ms"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "fade",
                      "cut",
                      "fly"
                    ]
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3000
                  }
                }
              }
            }
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generated_at",
            "pipeline_version",
            "source",
            "agent_trace",
            "validation",
            "stats"
          ],
          "properties": {
            "generated_at": {
              "type": "string"
            },
            "pipeline_version": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "deepworks",
                "local-runner",
                "manual"
              ]
            },
            "agent_trace": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "agent",
                  "status",
                  "elapsed_ms",
                  "summary"
                ],
                "properties": {
                  "agent": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ok",
                      "warn",
                      "error"
                    ]
                  },
                  "elapsed_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "summary": {
                    "type": "string"
                  },
                  "stage_id": {
                    "type": "string",
                    "enum": [
                      "parse-plan",
                      "narrate-dispatch",
                      "compose-validate"
                    ],
                    "description": "可选。对应流水线阶段标识，便于前端/评测按阶段对齐。"
                  },
                  "model": {
                    "type": "string",
                    "description": "可选。该阶段实际调用的模型名；本地兜底运行器可填 local-runner。"
                  },
                  "tool_calls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "可选。该阶段调用过的工具名列表。"
                  },
                  "started_at": {
                    "type": "string",
                    "description": "可选。该阶段开始时刻（ISO 8601 字符串）。"
                  },
                  "tokens": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "in",
                      "out"
                    ],
                    "properties": {
                      "in": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "out": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "description": "可选。该阶段 token 用量。"
                  }
                }
              }
            },
            "validation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "valid",
                "issues"
              ],
              "properties": {
                "valid": {
                  "type": "boolean"
                },
                "issues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "可选。不影响 valid 的体验提示（最佳时段错配、末站过晚、单段过长等）。validator 总是输出数组，缺省视为空。"
                }
              }
            },
            "stats": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "poi_count",
                "total_duration_min",
                "interest_coverage",
                "walk_intensity"
              ],
              "properties": {
                "poi_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_duration_min": {
                  "type": "integer",
                  "minimum": 0
                },
                "interest_coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "walk_intensity": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "v1_1_0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "meta",
        "route"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.1.0"
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "source",
            "generated_at",
            "city",
            "budget",
            "dropped",
            "agent_trace"
          ],
          "properties": {
            "schema_version": {
              "type": "string",
              "const": "1.1.0"
            },
            "source": {
              "type": "string",
              "enum": [
                "deepworks",
                "local",
                "llm"
              ]
            },
            "generated_at": {
              "type": "string",
              "minLength": 10
            },
            "pipeline_version": {
              "type": "string"
            },
            "city": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "pack_version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z_]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "pack_version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "budget": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "input_min",
                "total_min",
                "breakdown"
              ],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "strict",
                    "flexible"
                  ]
                },
                "input_min": {
                  "type": "integer",
                  "minimum": 1
                },
                "total_min": {
                  "type": "integer",
                  "minimum": 0
                },
                "breakdown": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "walk_min",
                    "stay_min"
                  ],
                  "properties": {
                    "walk_min": {
                      "type": "number",
                      "minimum": 0
                    },
                    "stay_min": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "dropped": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "reason",
                  "kind"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 4
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "budget_exceeded",
                      "closed",
                      "score_below_threshold",
                      "not_selected",
                      "user_removed"
                    ]
                  }
                }
              }
            },
            "agent_trace": {
              "type": "array",
              "minItems": 5,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "step",
                  "label",
                  "input_summary",
                  "output_summary",
                  "hits",
                  "duration_ms",
                  "evidence_refs",
                  "warnings"
                ],
                "properties": {
                  "step": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "input_summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "output_summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hits": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "warnings": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "validation": {
              "type": "object",
              "properties": {
                "valid": {
                  "type": "boolean"
                },
                "issues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "stats": {
              "type": "object"
            }
          }
        },
        "route": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "id",
              "name",
              "lat",
              "lng",
              "stay_min",
              "score",
              "reason",
              "commentary",
              "assets",
              "leg"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              },
              "stay_min": {
                "type": "integer",
                "minimum": 1
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": "string",
                "minLength": 6
              },
              "commentary": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "assets": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "panorama": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "model3d": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "photo": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "leg": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/leg"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_id",
        "to_id",
        "distance_m",
        "walk_min",
        "routing_status"
      ],
      "properties": {
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "distance_m": {
          "type": "number",
          "minimum": 0
        },
        "walk_min": {
          "type": "number",
          "minimum": 0
        },
        "routing_status": {
          "type": "string",
          "enum": [
            "network",
            "fallback_straight",
            "unavailable"
          ]
        }
      }
    }
  }
}
