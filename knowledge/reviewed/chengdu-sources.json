  "attractions": {
    "chengdu_dongjiao": {
      "summary": "东郊记忆由原国营红光电子管厂旧址改建，保留工业遗存并发展文化创意活动。",
      "source_ids": [
        "src_chengdu_dongjiao_20261124"
      ],
      "checked_at": "2026-11-24"
    },
    "chengdu_jinli": {
      "summary": "锦里文化旅游街区毗邻武侯祠，以三国文化、民俗和非遗体验为特色。",
      "source_ids": [
        "src_chengdu_jinli_20261124"
      ],
      "checked_at": "2026-11-24"
    },
    "chengdu_jiuyanqiao": {
      "summary": "九眼桥位于一环路南一段附近，与滨江东路合江亭附近的安顺廊桥是不同的桥。",
      "source_ids": [
        "src_chengdu_jiuyanqiao_20261124"
      ],
      "checked_at": "2026-11-24"
    },
    "chengdu_kuanzhai": {
      "summary": "宽窄巷子包括宽巷子、窄巷子和井巷子，展示成都街巷与院落文化。",
      "source_ids": [
        "src_chengdu_kuanzhai_20261124"
      ],
      "checked_at": "2026-11-24"
    },
    "chengdu_panda": {
      "summary": "成都大熊猫繁育研究基地位于成都市成华区，开展大熊猫等珍稀野生动物保护、繁育与科普。",
      "source_ids": [
        "src_chengdu_panda_20261124"
      ],
      "checked_at": "2026-11-24"
    },
    "chengdu_renmin_park": {
      "summary": "成都人民公园原名少城公园，园内有鹤鸣茶社。",
      "source_ids": [
        "src_chengdu_renmin_park_20261124"
      ],
      "checked_at": "2026-11-24"
    },
    "chengdu_taikooli": {
